{
  "name": "asciiquarium",
  "version": "2.0.0-beta.2",
  "description": "A reproduction of the asciiquarium screensaver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patebry/asciiquarium.git"
  },
  "bugs": {
    "url": "https://github.com/patebry/asciiquarium/issues"
  },
  "bin": {
    "asciiquarium": "./run.sh"
  },
  "scripts": {
    "start": "./run.sh",
    "start:node": "ASCIIQUARIUM_IMPL=node ./run.sh",
    "start:perl": "ASCIIQUARIUM_IMPL=perl ./run.sh"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ascii",
    "art",
    "asciiquarium",
    "screensaver",
    "terminal",
    "cli"
  ],
  "author": "Pate Bryant",
  "license": "GPL-2.0-only",
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "run.sh",
    "asciiquarium",
    "src/**/*"
  ]
}
